# Copiam-se as variáveis deste arquivo para o arquivo .env (cp .env.example .env).
# Em sistemas Linux, os usuários substituem o valor abaixo pelo resultado de `id -u`,
# evitando-se problemas de permissão na pasta logs/. Em sistemas Windows e macOS,
# mantêm-se os 50000 padrão.
AIRFLOW_UID=50000

# Definem-se as credenciais de acesso à interface web.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
